{
  "name": "taskflow-workspace",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,web -c green,blue \"npm:dev:server\" \"npm:dev:client\"",
    "dev:client": "npm run dev --workspace @taskflow/client",
    "dev:server": "npm run dev --workspace @taskflow/server",
    "start:server": "npm run start --workspace @taskflow/server",
    "db:migrate": "npm run migrate --workspace @taskflow/server",
    "lint": "eslint client server",
    "build": "npm run build --workspace @taskflow/client",
    "test": "npm test --workspace @taskflow/server",
    "format": "prettier --write client server README.md package.json eslint.config.js",
    "format:check": "prettier --check client server README.md package.json eslint.config.js"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "concurrently": "^9.2.1",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "prettier": "^3.9.9"
  }
}
